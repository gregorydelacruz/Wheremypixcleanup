import type { Handler } from '@netlify/functions';

export const handler: Handler = async () => {
  const domain   = process.env.AUTH0_DOMAIN!;        // e.g. dev-xxxx.us.auth0.com (no https://)
  const clientId = process.env.AUTH0_CLIENT_ID!;     // your Auth0 App (regular web) client id
  const redirect = process.env.AUTH0_REDIRECT_URI    // must be in Allowed Callback URLs
                || 'https://www.wherearemypics.info';

  const url = new URL(`https://${domain}/authorize`);
  url.search = new URLSearchParams({
    response_type: 'code',
    client_id: clientId,
    redirect_uri: redirect,
    scope: 'openid email profile offline_access',
    connection: 'google-oauth2',
    prompt: 'select_account',
  }).toString();

  return {
    statusCode: 302,
    headers: { Location: url.toString() },
  };
};
